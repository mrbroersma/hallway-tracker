{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "worker/**/*.ts", "cloudflare-env.d.ts", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
