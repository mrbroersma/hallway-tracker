{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hallway-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hallway-tracker",
      "database_id": "806d59d9-c549-4c25-8ca5-728061508f63",
      "migrations_dir": "migrations"
    }
  ]
}
